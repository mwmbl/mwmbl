{
  "scripts": {
    "dokku": {
      "predeploy": "rm -rf /app/static/* && cp -r /front-end-build/* /app/static/"
    }
  },
  "cron": [
    {
      "command": "ionice -c2 -n7 /venv/bin/python /app/manage.py backup_index",
      "schedule": "17 3 1 * *"
    }
  ],
  "healthchecks": {
    "web": [
      {
        "type": "startup",
        "name": "search answers",
        "path": "/api/v1/search/?s=rydnik",
        "initialDelay": 30,
        "attempts": 20,
        "wait": 10,
        "timeout": 10
      }
    ]
  }
}
