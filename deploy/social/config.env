# Non-secret config for social.mwmbl.org. setup.sh applies it with `dokku config:set`.
# One KEY=value per line, no quotes: everything after the first `=` is the value.
# The fields are described in the Mwmbl Social README (Configuration).

# The base URL is in every registration and in our actor's URI, so it must never change.
MWMBL_SOCIAL_BASE_URL=https://social.mwmbl.org
MWMBL_SOCIAL_NAME=Mwmbl Social
# CHANGE-ME: the address server admins see in their FASP list. setup.sh refuses to run until
# this is replaced.
MWMBL_SOCIAL_CONTACT_EMAIL=CHANGE-ME
# The pages under /social/ on mwmbl.org don't exist yet; they come in later pull requests.
MWMBL_SOCIAL_PRIVACY_POLICY_URL=https://mwmbl.org/social/privacy/
MWMBL_SOCIAL_SIGN_IN_URL=https://mwmbl.org/social/connect/
MWMBL_SOCIAL_ROOT_REDIRECT=https://mwmbl.org/social/connect/

# The container's port; Dokku's nginx maps port 80 (and 443) to it.
MWMBL_SOCIAL_LISTEN=0.0.0.0:8080
# The storage mount (see setup.sh). SQLite, the index files and the keys live here.
MWMBL_SOCIAL_DATA_DIR=/data

# Index sizes in 4 KiB pages, 16 times the self-host defaults: 4 GiB for posts and 1 GiB for
# accounts. The files are allocated in full when first created. They are fixed from then on:
# an existing index keeps its size whatever these say, so changing them later means a rebuild.
MWMBL_SOCIAL_POSTS_PAGES=1048576
MWMBL_SOCIAL_ACCOUNTS_PAGES=262144

# /metrics would be public through Dokku's nginx, so it stays off until it can be served
# privately.
MWMBL_SOCIAL_METRICS=false
