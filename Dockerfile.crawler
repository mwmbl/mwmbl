FROM rust:1.97-bookworm AS builder

WORKDIR /app

# Only what the crawler is built from, so nothing else changing invalidates the build cache:
# its two crates, and the Wikipedia stats mwmbl_core's build script compiles in.
COPY mwmbl/resources/wiki_stats.json /app/mwmbl/resources/wiki_stats.json
COPY rust/mwmbl_core /app/rust/mwmbl_core
COPY rust/crawler /app/rust/crawler

# --locked builds exactly the Cargo.lock the tests ran against.
RUN cargo build --release --locked --manifest-path rust/crawler/Cargo.toml

# The final stage ships to crawler volunteers, so it carries nothing but the binary and
# the CA certificates its HTTPS requests are verified against. Same Debian release as the
# builder, so the binary finds the glibc it was linked against.
FROM debian:bookworm-slim AS final

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/rust/crawler/target/release/crawler_rs /usr/local/bin/mwmbl-crawl

RUN useradd --uid 1000 --create-home mwmbl && \
    mkdir -p /home/mwmbl/.mwmbl && \
    chown -R mwmbl:mwmbl /home/mwmbl
USER mwmbl
WORKDIR /home/mwmbl

CMD ["/usr/local/bin/mwmbl-crawl"]
